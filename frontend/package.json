{
  "name": "frontend",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "perf:budget": "node scripts/check-budgets.mjs",
    "perf:lighthouse": "node scripts/run-lighthouse.mjs --profile desktop",
    "perf:lighthouse:mobile": "node scripts/run-lighthouse.mjs --profile mobile",
    "arch:layers": "node scripts/check-layering.mjs",
    "smoke:prod": "node scripts/prod-smoke.mjs",
    "docs:screenshots": "node scripts/capture-doc-screenshots.mjs",
    "lint": "eslint .",
    "test": "vitest run && node --test scripts/build-meta.test.mjs scripts/prod-smoke.test.mjs scripts/security-token-storage.test.mjs scripts/run-lighthouse.test.mjs",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:persona-proxy": "playwright test tests/e2e/persona-session-matrix.spec.ts",
    "test:e2e:mobile-proxy": "playwright test tests/e2e/mobile-validation-matrix.spec.ts",
    "test:first-click": "playwright test tests/e2e/first-click.spec.ts",
    "test:a11y": "playwright test tests/a11y",
    "test:a11y:user-proxy": "playwright test tests/a11y/accessibility-user-proxy.spec.ts",
    "test:visual": "playwright test tests/visual --project=visual",
    "verify:visual": "./scripts/verify-visual.sh",
    "verify:visual:update": "./scripts/verify-visual.sh --update-snapshots",
    "test:design-qa-evidence": "CAPTURE_DESIGN_QA_EVIDENCE=1 playwright test tests/visual/design-qa-evidence.spec.ts",
    "test:content": "vitest run src/content.lint.test.ts",
    "test:qa": "playwright test",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@tailwindcss/vite": "^4.2.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "lighthouse": "^13.4.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  }
}
