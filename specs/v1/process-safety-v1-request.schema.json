{
  "$defs": {
    "InformationFlow": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "delegation_depth": {
          "default": 0,
          "maximum": 16,
          "minimum": 0,
          "title": "Delegation Depth",
          "type": "integer"
        },
        "destination": {
          "enum": [
            "context",
            "model",
            "tool",
            "memory",
            "artifact",
            "external"
          ],
          "title": "Destination",
          "type": "string"
        },
        "flow_id": {
          "pattern": "^[a-z][a-z0-9_-]{1,127}$",
          "title": "Flow Id",
          "type": "string"
        },
        "redacted_manifest_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redacted Manifest Digest"
        },
        "sensitivity": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "CONFIDENTIAL",
            "RESTRICTED",
            "SECRET"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "source": {
          "enum": [
            "context",
            "model",
            "tool",
            "memory",
            "artifact",
            "external"
          ],
          "title": "Source",
          "type": "string"
        },
        "tool_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Digest"
        }
      },
      "required": [
        "flow_id",
        "source",
        "destination",
        "sensitivity"
      ],
      "title": "InformationFlow",
      "type": "object"
    },
    "PlanTransition": {
      "additionalProperties": false,
      "properties": {
        "from_state": {
          "enum": [
            "DRAFT",
            "PENDING_APPROVAL",
            "APPROVED",
            "EVALUATED",
            "ADMITTED",
            "REJECTED",
            "QUARANTINED",
            "INCONCLUSIVE"
          ],
          "title": "From State",
          "type": "string"
        },
        "to_state": {
          "enum": [
            "PENDING_APPROVAL",
            "APPROVED",
            "REJECTED",
            "EVALUATED",
            "ADMITTED",
            "QUARANTINED",
            "INCONCLUSIVE"
          ],
          "title": "To State",
          "type": "string"
        },
        "transition_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Transition Digest",
          "type": "string"
        }
      },
      "required": [
        "from_state",
        "to_state",
        "transition_digest"
      ],
      "title": "PlanTransition",
      "type": "object"
    },
    "ProcessSafetyOutcome": {
      "additionalProperties": false,
      "properties": {
        "evidence_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "outcome_type": {
          "enum": [
            "unnecessary_sensitive_data_access",
            "prohibited_tool",
            "permission_escalation",
            "network_egress",
            "secret_exposure",
            "unsafe_intermediate_artifact",
            "policy_bypassing_retry",
            "sensitive_persistent_memory",
            "trace_log_leakage",
            "cleanup_failure"
          ],
          "title": "Outcome Type",
          "type": "string"
        },
        "state": {
          "enum": [
            "NOT_OBSERVED",
            "BLOCKED",
            "DETECTED",
            "UNKNOWN"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "outcome_type",
        "state",
        "evidence_digest"
      ],
      "title": "ProcessSafetyOutcome",
      "type": "object"
    },
    "ProcessSafetyPolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_external_egress": {
          "const": false,
          "default": false,
          "title": "Allow External Egress",
          "type": "boolean"
        },
        "allowed_tool_digests": {
          "items": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Allowed Tool Digests",
          "type": "array"
        },
        "maximum_delegation_depth": {
          "default": 0,
          "maximum": 16,
          "minimum": 0,
          "title": "Maximum Delegation Depth",
          "type": "integer"
        },
        "maximum_sensitivity": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "CONFIDENTIAL",
            "RESTRICTED",
            "SECRET"
          ],
          "title": "Maximum Sensitivity",
          "type": "string"
        },
        "policy_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "required_cleanup": {
          "const": true,
          "default": true,
          "title": "Required Cleanup",
          "type": "boolean"
        },
        "secret_retention": {
          "const": "digests_and_redacted_manifests_only",
          "default": "digests_and_redacted_manifests_only",
          "title": "Secret Retention",
          "type": "string"
        }
      },
      "required": [
        "policy_digest",
        "maximum_sensitivity"
      ],
      "title": "ProcessSafetyPolicy",
      "type": "object"
    }
  },
  "$id": "https://scaffold-arena.local/specs/v1/process-safety-v1-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cleanup_receipt_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cleanup Receipt Digest"
    },
    "execution_started": {
      "const": false,
      "default": false,
      "title": "Execution Started",
      "type": "boolean"
    },
    "flows": {
      "items": {
        "$ref": "#/$defs/InformationFlow"
      },
      "maxItems": 512,
      "minItems": 1,
      "title": "Flows",
      "type": "array"
    },
    "network_requested": {
      "const": false,
      "default": false,
      "title": "Network Requested",
      "type": "boolean"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/ProcessSafetyOutcome"
      },
      "maxItems": 10,
      "minItems": 10,
      "title": "Outcomes",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/ProcessSafetyPolicy"
    },
    "request_id": {
      "pattern": "^[a-z][a-z0-9_-]{1,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "scaffold-arena.process-safety/1",
      "default": "scaffold-arena.process-safety/1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_manifest_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Source Manifest Digest",
      "type": "string"
    },
    "transitions": {
      "items": {
        "$ref": "#/$defs/PlanTransition"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Transitions",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "policy",
    "flows",
    "outcomes",
    "transitions",
    "source_manifest_digest"
  ],
  "title": "ProcessSafetyRequest",
  "type": "object"
}
