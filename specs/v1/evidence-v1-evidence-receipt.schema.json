{
  "$id": "https://scaffold-arena.local/specs/v1/evidence-v1-evidence-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_hashes": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Hashes",
      "type": "array"
    },
    "integrity_not_truth": {
      "const": true,
      "default": true,
      "title": "Integrity Not Truth",
      "type": "boolean"
    },
    "manifest_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Hash",
      "type": "string"
    },
    "receipt_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Receipt Hash",
      "type": "string"
    },
    "receipt_id": {
      "minLength": 1,
      "title": "Receipt Id",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "manifest_hash",
    "artifact_hashes",
    "receipt_hash"
  ],
  "title": "EvidenceReceipt",
  "type": "object"
}
