    },
    "rubric_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Rubric Id",
      "type": "string"
    },
    "version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "rubric_id",
    "version",
    "digest",
    "dimensions"
  ],
  "title": "HumanRubric",
  "type": "object"
}
