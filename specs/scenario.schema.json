{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://scaffold-arena.local/specs/scenario.schema.json",
  "title": "Scaffold Arena Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "name",
    "task_family",
    "prompt",
    "output_schema",
    "gold_reference",
    "deterministic_metrics",
    "evidence_requirements",
    "synthetic_sources",
    "allowed_claims",
    "limitations"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.1$" },
    "scenario_id": { "type": "string", "minLength": 3 },
    "name": { "type": "string", "minLength": 3 },
    "task_family": { "type": "string", "minLength": 3 },
    "prompt": { "type": "string", "minLength": 20 },
    "output_schema": { "type": "object" },
    "gold_reference": { "type": ["object", "array"] },
    "deterministic_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "weight", "method"],
        "properties": {
          "metric_id": { "type": "string", "minLength": 2 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "method": { "type": "string", "minLength": 10 }
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "synthetic_sources": { "type": "boolean" },
    "allowed_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    }
  }
}
