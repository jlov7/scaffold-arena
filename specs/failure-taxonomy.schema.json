{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://scaffold-arena.local/specs/failure-taxonomy.schema.json",
  "title": "Scaffold Arena Failure Taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "taxonomy_version", "failure_types"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.1$" },
    "taxonomy_version": { "type": "string", "minLength": 3 },
    "failure_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "default_severity",
          "description",
          "signals",
          "recommendation",
          "regression_key_pattern",
          "suggested_fixture"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "default_severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "description": { "type": "string", "minLength": 10 },
          "signals": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "recommendation": { "type": "string", "minLength": 10 },
          "regression_key_pattern": { "type": "string", "minLength": 5 },
          "suggested_fixture": { "type": "string", "minLength": 5 }
        }
      }
    }
  }
}
