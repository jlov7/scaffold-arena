{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://scaffold-arena.local/specs/eval-card.schema.json",
  "title": "Scaffold Arena Eval Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "eval_card_id",
    "task_family",
    "deterministic_weight",
    "metrics",
    "pass_thresholds",
    "failure_modes",
    "allowed_claims",
    "limitations"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.1$" },
    "eval_card_id": { "type": "string", "minLength": 3 },
    "task_family": { "type": "string", "minLength": 3 },
    "deterministic_weight": { "type": "number", "minimum": 0.7, "maximum": 1 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "weight", "type", "description"],
        "properties": {
          "metric_id": { "type": "string", "minLength": 2 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "type": { "enum": ["deterministic", "judge"] },
          "description": { "type": "string", "minLength": 10 }
        }
      }
    },
    "pass_thresholds": {
      "type": "object",
      "required": ["minimum_total_score", "blocking_conditions"],
      "properties": {
        "minimum_total_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "blocking_conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "allowed_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    }
  }
}
