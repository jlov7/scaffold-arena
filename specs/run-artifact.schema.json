{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://scaffold-arena.local/specs/run-artifact.schema.json",
  "title": "Scaffold Arena Run Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "protocol_version",
    "mode",
    "scenario_id",
    "task_family",
    "model_id",
    "scaffold_id",
    "evaluation_profile",
    "created_at",
    "output",
    "metrics",
    "evaluation",
    "evidence",
    "limitations"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.1$" },
    "run_id": { "type": "string", "minLength": 3 },
    "protocol_version": { "type": "string", "pattern": "^0\\.1$" },
    "mode": { "type": "string", "enum": ["fixture", "live", "sample"] },
    "task_id": { "type": "string", "minLength": 2 },
    "control": { "type": "string", "minLength": 2 },
    "expected_role": { "type": "string", "enum": ["positive", "negative"] },
    "scenario_id": { "type": "string", "minLength": 3 },
    "task_family": { "type": "string", "minLength": 3 },
    "model_id": { "type": "string", "minLength": 3 },
    "scaffold_id": { "type": "string", "minLength": 2 },
    "evaluation_profile": { "type": "string", "minLength": 3 },
    "created_at": { "type": "string", "minLength": 10 },
    "completed_at": { "type": "string", "minLength": 10 },
    "output": { "type": ["object", "array", "string"] },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cost_usd", "wall_time_ms", "num_api_calls"],
      "properties": {
        "input_tokens": { "type": "number", "minimum": 0 },
        "output_tokens": { "type": "number", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "wall_time_ms": { "type": ["number", "null"], "minimum": 0 },
        "num_api_calls": { "type": "number", "minimum": 0 },
        "provider_usage_status": { "type": "string" },
        "measurement_scope": { "type": "string" },
        "latency_status": { "type": "string" }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_score", "deterministic_weight", "breakdown", "notes"],
      "properties": {
        "total_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "deterministic_weight": { "type": "number", "minimum": 0.7, "maximum": 1 },
        "breakdown": { "type": "object" },
        "weights": { "type": "object" },
        "profile": { "type": "string" },
        "judge": { "type": ["object", "null"] },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "summary"],
        "properties": {
          "kind": { "type": "string", "minLength": 3 },
          "summary": { "type": "string", "minLength": 5 },
          "source": { "type": "string" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "fixture" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "model_id": { "const": "fixture-no-provider-deterministic-v1" },
          "metrics": {
            "required": [
              "input_tokens",
              "output_tokens",
              "cost_usd",
              "wall_time_ms",
              "num_api_calls",
              "provider_usage_status",
              "measurement_scope",
              "latency_status"
            ],
            "properties": {
              "input_tokens": { "const": 0 },
              "output_tokens": { "const": 0 },
              "cost_usd": { "const": 0 },
              "wall_time_ms": { "type": "null" },
              "num_api_calls": { "const": 0 },
              "provider_usage_status": { "const": "known_none_no_provider_invoked" },
              "measurement_scope": { "const": "fixture_deterministic_controls" },
              "latency_status": { "const": "not_measured" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "model_id": { "not": { "const": "fixture-no-provider-deterministic-v1" } },
          "metrics": {
            "properties": {
              "wall_time_ms": { "type": "number", "minimum": 0 }
            },
            "not": {
              "anyOf": [
                { "required": ["provider_usage_status"] },
                { "required": ["measurement_scope"] },
                { "required": ["latency_status"] }
              ]
            }
          }
        }
      }
    }
  ]
}
